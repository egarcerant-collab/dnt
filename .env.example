# Ruta al Excel de seguimiento (por defecto data/raw/BASE_DNT_SEM36_2026.xlsx)
DNT_EXCEL_PATH=
# Almacenamiento en Google Drive (si no se configura, usa data/app/*.json local)
GDRIVE_FOLDER_ID=
GOOGLE_SERVICE_ACCOUNT_JSON=
# Administrador inicial (solo en .env.local)
ADMIN_USUARIO=
ADMIN_PASSWORD=
ADMIN_NOMBRE=
# Obligatorio en producción
SESSION_SECRET=
# Carpeta para datos locales (en Vercel sin Drive se usa /tmp, que se borra en cada reinicio)
DATA_DIR=
# Correo de notificaciones (Gmail de Google Workspace con contraseña de aplicación)
SMTP_USER=nutria@dusakawiepsi.com
SMTP_PASS=
APP_URL=https://dnt-nine.vercel.app
# Informe semanal (Vercel Cron envía Authorization: Bearer CRON_SECRET)
CRON_SECRET=
# Uso local: ruta al archivo .json de la cuenta de servicio (en lugar de GOOGLE_SERVICE_ACCOUNT_JSON)
GOOGLE_SERVICE_ACCOUNT_FILE=
